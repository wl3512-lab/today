{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quiz Profile",
  "type": "object",
  "required": ["id", "format", "length", "difficulty", "questions", "totalPoints"],
  "properties": {
    "id": { "type": "string" },
    "sourcePhoto": { "type": "string" },
    "format": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "instructions": { "type": "string" },
        "calculatorAllowed": { "type": "boolean" },
        "showWork": { "type": "boolean" }
      }
    },
    "length": { "type": "integer", "minimum": 1 },
    "topics": { "type": "string" },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "type", "points", "text"],
        "properties": {
          "number": { "type": "integer" },
          "type": { "enum": ["multiple_choice", "short_answer", "show_work"] },
          "points": { "type": "number" },
          "text": { "type": "string" },
          "parts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "totalPoints": { "type": "number" }
  }
}
