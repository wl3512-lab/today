EXT_BY_TYPE = {
    "application/vnd.openxmlformats-officedocument.wordprocessingml.document": ".docx",
    "application/msword": ".doc",
    "application/pdf": ".pdf",
    "application/rtf": ".rtf",
    "text/rtf": ".rtf",
}


def extract_file(path, content_type=""):
    """Plain text from a local document. textutil covers Office/RTF/HTML;
    PDFs go through Quartz, which ships with macOS PyObjC."""
    ext = os.path.splitext(path)[1].lower()
    if ext == ".pdf" or "pdf" in (content_type or ""):
        try:
            from Quartz import PDFDocument
            from Foundation import NSURL
            doc = PDFDocument.alloc().initWithURL_(NSURL.fileURLWithPath_(path))
            return (doc.string() or "").strip() if doc else ""
        except Exception as exc:
            return "[could not read PDF: %s]" % exc
    try:
        p = subprocess.run(["/usr/bin/textutil", "-convert", "txt", "-stdout", path],
                           capture_output=True, text=True, timeout=60)
        if p.returncode == 0:
            return p.stdout.strip()
        return "[textutil failed: %s]" % (p.stderr.strip()[:120],)
    except Exception as exc:
        return "[extraction failed: %s]" % exc


def google_export(url):
    """Rewrite a published Google URL to its clean export form.

    A published Sheet as CSV beats scraping its rendered HTML table, and it is
    the difference between a usable course schedule and a wall of markup.
    """
    import re
    m = re.match(r"(https://docs\.google\.com/spreadsheets/d/e/[^/]+)/pubhtml", url)
    if m:
        return m.group(1) + "/pub?output=csv", "csv"
    return url, None


def fetch_external(url):
    """Published Google Docs and similar are public - fetch them directly."""
    url, mode = google_export(url)
    try:
        p = subprocess.run(
            ["curl", "-sSL", "-m", "45", "--compressed", url],
            capture_output=True, timeout=60)
        if p.returncode != 0:
            return "[fetch failed: %s]" % p.stderr.decode("utf-8", "replace").strip()[:120]
        raw = p.stdout
        if mode == "csv":
            return raw.decode("utf-8", "replace").strip()
        head = raw[:400].lower()
        if b"<html" in head or b"<!doctype" in head:
            text = raw.decode("utf-8", "replace")
            # Google Docs put the real document inside #contents; using it skips
            # all the viewer chrome around it.
            import re
            m = re.search(r'(?is)<div[^>]+id="contents".*?>(.*)</div>\s*</body>', text)
            return strip_html(m.group(1) if m else text)
        # binary (an exported .docx/.pdf): extract via a temp file
        with tempfile.NamedTemporaryFile(delete=False, suffix=".bin") as fh:
            fh.write(raw)
            tmp = fh.name
        try:
            return extract_file(tmp)
        finally:
            os.unlink(tmp)
    except Exception as exc:
        return "[fetch failed: %s]" % exc


def doc_text(d):
    """Plain text for one syllabus document, whatever form it arrived in."""
    kind = d.get("kind")
    if kind == "html":
        return strip_html(d.get("html", ""))
    if kind == "external":
        return fetch_external(d["url"])
    if kind == "binary":
        ext = EXT_BY_TYPE.get((d.get("contentType") or "").split(";")[0].strip(), "")
        if not ext:
            ext = os.path.splitext(d.get("url", ""))[1][:6] or ".bin"
        try:
            blob = base64.b64decode(d.get("b64", ""))
        except Exception as exc:
            return "[bad payload: %s]" % exc
        with tempfile.NamedTemporaryFile(delete=False, suffix=ext) as fh:
            fh.write(blob)
            tmp = fh.name
        try:
            return extract_file(tmp, d.get("contentType", ""))
        finally:
            os.unlink(tmp)
    return "[%s]" % d.get("note", "unreadable")


def cmd_syllabus(a):
    """Find and extract syllabus-ish content for the pinned (or given) courses."""
    if a.course:
        sel = "[{id:%s}]" % a.course
    elif a.all:
        sel = "await activeCourses()"
    else:
        sel = "await pinnedCourses()"

    body = r"""
    const SYL = /syllabus|course\s*info|course\s*overview|course\s*outline|greensheet|start\s*here/i;
    const courses = %s;
    const named = await activeCourses();
    const results = await Promise.all(courses.map(function (c) {
      const meta = named.filter(function (n) { return n.id == c.id; })[0] || c;
      return settle(meta.name || String(c.id), async function () {
        const topics = await tocTopics(c.id);
        // quickLink/dialog URLs are Brightspace UI pages wrapping an activity,
        // not documents - extracting them returns page chrome, not content.
        const readable = topics.filter(function (t) {
          return t.url && !/quickLink|\/d2l\/common\/dialogs/i.test(t.url);
        });
        const hits = readable.filter(function (t) { return SYL.test(t.title) || SYL.test(t.path); });
        const picked = (hits.length ? hits : readable).slice(0, %d);
        const docs = [];
        for (const t of picked) {
          const b = await topicBody(t.url);
          docs.push({
            title: t.title, path: t.path, url: b.url || t.url,
            kind: b.kind, note: b.note,
            contentType: b.contentType || null,
            html: b.text || "", b64: b.b64 || "",
          });
        }
        return {
          course: meta.name || String(c.id), courseId: c.id,
          matched: hits.length, totalTopics: topics.length, docs: docs,
        };
      });
    }));
    return results;
    """ % (sel, a.limit)

    data = run_js(body, timeout=420)

    def show(rs):
        for r in rs:
            if not r["ok"]:
                print("! %s: %s" % (r["label"], r["error"]), file=sys.stderr)
                continue
            v = r["value"]
            print("\n%s  (%d syllabus-ish of %d topics)" % (
                v["course"], v["matched"], v["totalTopics"]))
            for d in v["docs"]:
                print("  - %s" % d["title"])
                if d["path"]:
                    print("    in: %s" % d["path"])
                url = d.get("url", "")
                if url and not url.startswith("http"):
                    url = HOST + url
                if url:
                    print("    %s" % url)
                text = doc_text(d)
                shown = [ln for ln in text.splitlines() if ln.strip()][:a.lines]
                for ln in shown:
                    print("    %s" % ln)
    out(data, a.json, show)
    return 0


# --------------------------------------------------------------------------
# normalized feed - the contract the OS layer consumes
# --------------------------------------------------------------------------
#
# Every connector (brightspace, gmail, gcal, ...) emits this same Item shape
# so the aggregator can merge them without knowing the source. Documented in
# CONNECTOR.md; keep the two in sync when changing anything here.
#
#   id       stable + globally unique, "<source>:<kind>:<scope>:<localId>"
#   source   connector name
#   kind     deadline | message | grade | event
#   title    one line, no markup
#   body     plain text, may be ""
#   url      deep link back to the source, or null
#   at       ISO8601 UTC - the moment that matters (due date, sent date)
#   context  course / calendar / thread name
#   status   open | done | overdue | null
#   meta     source-specific passthrough, never interpreted by the OS

CACHE = os.path.expanduser("~/.brightspace-cache.json")
SOURCE = "brightspace"


def item(kind, scope, local_id, title, at, context,
         body="", url=None, status=None, meta=None):
    return {
        "id": "%s:%s:%s:%s" % (SOURCE, kind, scope, local_id),
        "source": SOURCE,
        "kind": kind,
        "title": title or "",
        "body": body or "",
        "url": url,
        "at": to_utc(at),
        "context": context or "",
        "status": status,
        "meta": meta or {},
    }


def to_utc(s):
    dt = parse_dt(s)
    if not dt:
        return None
    return dt.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def deadline_status(at, submitted):
    if submitted:
        return "done"
    dt = parse_dt(at)
    if dt and dt < datetime.now(timezone.utc):
        return "overdue"
    return "open"


GATHER_JS = r"""
const courses = await activeCourses();
const per = await Promise.all(courses.map(function (c) {
  return settle(c.name, async function () {
    const base = "/d2l/api/le/" + LE + "/" + c.id;
    return {
      course: c,
      assignments: await soft(function () { return api(base + "/dropbox/folders/"); }, []),
      quizzes:     await soft(function () { return paged(base + "/quizzes/"); }, []),
      news:        await soft(function () { return api(base + "/news/"); }, []),
      discussions: await soft(function () { return discussionTopics(c.id); }, []),
      content:     await soft(function () { return tocTopics(c.id); }, []),
      grades:      await soft(function () { return api(base + "/grades/values/myGradeValues/"); }, []),
    };
  });
}));
return per;
"""


def build_feed():
    """One browser round-trip -> normalized items for every active course."""
    per = run_js(GATHER_JS)
    items, errors = [], []

    for row in per:
        if not row.get("ok"):
            errors.append({"context": row.get("label"), "error": row.get("error")})
            continue
        v = row["value"]
        c = v["course"]
        cid, cname = c["id"], c["name"]

        for f in v.get("assignments") or []:
            # See the note in the JS above: TotalUsersWithSubmissions is a
            # class-wide count, never evidence about this student.
            submitted = f.get("CompletionStatus") == 1
            items.append(item(
                "deadline", cid, f.get("Id"),
                f.get("Name"), f.get("DueDate"), cname,
                body=strip_html((f.get("CustomInstructions") or {}).get("Html", "")),
                url="%s/d2l/lms/dropbox/user/folder_submit_files.d2l?db=%s&ou=%s" % (HOST, f.get("Id"), cid),
                status=deadline_status(f.get("DueDate"), submitted),
                meta={"type": "assignment", "courseId": cid},
            ))

        for q in v.get("quizzes") or []:
            items.append(item(
                "deadline", cid, "quiz-%s" % q.get("Id"),
                q.get("Name"), q.get("DueDate"), cname,
                url="%s/d2l/lms/quizzing/user/quizzes_list.d2l?ou=%s" % (HOST, cid),
                status=deadline_status(q.get("DueDate"), False),
                meta={"type": "quiz", "courseId": cid},
            ))

        for t in v.get("discussions") or []:
            if not t.get("due"):
                continue
            pts = " (%s pts)" % t["points"] if t.get("points") else ""
            items.append(item(
                "deadline", cid, "disc-%s" % t.get("id"),
                (t.get("name") or "") + pts, t.get("due"), cname,
                url="%s/d2l/le/%s/discussions/topics/%s/View" % (HOST, cid, t.get("id")),
                status=deadline_status(t.get("due"), False),
                meta={"type": "discussion", "courseId": cid, "forum": t.get("forum"),
                      "points": t.get("points")},
            ))

        for t in v.get("content") or []:
            if not t.get("title"):
                continue
            url = t.get("url") or ""
            if url and not url.startswith("http"):
                url = HOST + url
            items.append(item(
                "material", cid, t.get("id"),
                t["title"], None, cname,
                body=t.get("path", ""),
                url=url or "%s/d2l/le/content/%s/Home" % (HOST, cid),
                meta={"type": "content", "courseId": cid, "module": t.get("path", "")},
            ))

        for n in v.get("news") or []:
            body = (n.get("Body") or {})
            items.append(item(
                "message", cid, n.get("Id"),
                n.get("Title"), n.get("StartDate"), cname,
                body=strip_html(body.get("Html") or body.get("Text") or ""),
                url="%s/d2l/le/news/%s/%s/view" % (HOST, cid, n.get("Id")),
                meta={"type": "announcement", "courseId": cid},
            ))

        for g in v.get("grades") or []:
            obj = g.get("GradeObjectName")
            score = g.get("DisplayedGrade")
            if g.get("PointsNumerator") is not None and g.get("PointsDenominator"):
                score = "%s / %s" % (g["PointsNumerator"], g["PointsDenominator"])
            if not score:
                continue
            items.append(item(
                "grade", cid, g.get("GradeObjectIdentifier") or obj,
                "%s: %s" % (obj, score), g.get("LastModified"), cname,
                url="%s/d2l/lms/grades/my_grades/main.d2l?ou=%s" % (HOST, cid),
                meta={
                    "type": "grade", "courseId": cid, "gradeItem": obj, "score": score,
                    "points": g.get("PointsNumerator"), "outOf": g.get("PointsDenominator"),
                },
            ))

    # Newest / soonest first; undated items sink to the bottom.
    items.sort(key=lambda i: i["at"] or "", reverse=True)
    return {
        "source": SOURCE,
        "fetchedAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "stale": False,
        "items": items,
        "errors": errors,
    }


def read_cache():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except (IOError, ValueError):
        return None


def write_cache(feed):
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(feed, f)
    os.replace(tmp, CACHE)   # atomic, so a reader never sees a half-written file


def cache_age(feed):
    ts = parse_dt(feed.get("fetchedAt"))
    if not ts:
        return None
    return (datetime.now(timezone.utc) - ts).total_seconds()


def cmd_feed(a):
    """Cache-first so a UI can paint instantly instead of waiting on a browser."""
    cached = read_cache()

    if a.cached:
        if not cached:
            print(json.dumps({"source": SOURCE, "items": [], "errors": [
                {"context": None, "error": "no cache yet - run: bs sync"}]}, indent=2))
            return 1
        age = cache_age(cached)
        cached["stale"] = age is None or age > a.max_age
        feed = cached
    elif cached and not a.refresh and (cache_age(cached) or 1e9) <= a.max_age:
        feed = cached
    else:
        try:
            feed = build_feed()
            write_cache(feed)
        except (AuthError, BrowserError):
            if cached:                      # serve stale rather than nothing
                cached["stale"] = True
                print(json.dumps(cached, indent=2))
                return 0
            raise

    items = feed["items"]
    if a.kind:
        items = [i for i in items if i["kind"] in a.kind]
    if a.days is not None:
        horizon = datetime.now(timezone.utc) + timedelta(days=a.days)
        floor = datetime.now(timezone.utc) - timedelta(days=a.days)
        keep = []
        for i in items:
            dt = parse_dt(i["at"])
            if dt and floor <= dt <= horizon:
                keep.append(i)
        items = keep

    print(json.dumps(dict(feed, items=items), indent=2))
    return 0


def cmd_sync(a):
    feed = build_feed()
    write_cache(feed)
    by_kind = {}
    for i in feed["items"]:
        by_kind[i["kind"]] = by_kind.get(i["kind"], 0) + 1
    print("Synced %d items -> %s" % (len(feed["items"]), CACHE))
    for k in sorted(by_kind):
        print("  %-9s %d" % (k, by_kind[k]))
    for e in feed["errors"]:
        print("  ! %s: %s" % (e["context"], e["error"]), file=sys.stderr)
    return 0


def main():
    p = argparse.ArgumentParser(prog="bs", description="Brightspace CLI")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("login", help="one-time school sign-in (opens a window)")
    s.add_argument("--wait", type=int, default=300, help="seconds to wait for login")
    s.set_defaults(fn=cmd_login)

    s = sub.add_parser("status", help="check whether the session is alive")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("courses", help="list active courses")
    s.add_argument("--pinned", action="store_true", help="only courses you pinned")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_courses)

    s = sub.add_parser("syllabus", help="extract syllabus content for pinned courses")
    s.add_argument("--course", help="org unit id (default: all pinned)")
    s.add_argument("--all", action="store_true", help="every active course, not just pinned")
    s.add_argument("--limit", type=int, default=3, help="max documents per course")
    s.add_argument("--lines", type=int, default=40, help="max text lines shown per document")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_syllabus)

    s = sub.add_parser("due", help="upcoming assignments and quizzes")
    s.add_argument("--days", type=int, default=14)
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_due)

    s = sub.add_parser("grades", help="grades, all courses or one")
    s.add_argument("--course", help="org unit id")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_grades)

    s = sub.add_parser("announcements", help="recent course announcements")
    s.add_argument("--course", help="org unit id")
    s.add_argument("--days", type=int, default=14)
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_announcements)

    s = sub.add_parser("content", help="course content table of contents")
    s.add_argument("course", help="org unit id")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_content)

    s = sub.add_parser("feed", help="normalized JSON feed for the OS layer (cache-first)")
    s.add_argument("--kind", action="append",
                   choices=["deadline", "message", "grade", "event"],
                   help="filter by kind, repeatable")
    s.add_argument("--days", type=int, help="only items within +/- N days")
    s.add_argument("--max-age", type=int, default=900,
                   help="seconds before the cache is refetched (default 900)")
    s.add_argument("--cached", action="store_true",
                   help="never hit the network, return cache as-is")
    s.add_argument("--refresh", action="store_true", help="force a refetch")
    s.set_defaults(fn=cmd_feed)

    s = sub.add_parser("sync", help="refresh the cache now")
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser("probe", help="report which Valence endpoints work for this account")
    s.set_defaults(fn=cmd_probe)

    s = sub.add_parser("api", help="raw authenticated GET, e.g. bs api /d2l/api/lp/{lp}/users/whoami")
    s.add_argument("path")
    s.set_defaults(fn=cmd_api)

    a = p.parse_args()
    try:
        return a.fn(a)
    except AuthError:
        print("Brightspace session expired. Run: bs login", file=sys.stderr)
        return 1
    except BrowserError as e:
        print("Browser error: %s" % e, file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired:
        print("Timed out talking to the browser.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
