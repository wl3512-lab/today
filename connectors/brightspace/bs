def cmd_login(a):
    global HEADED
    # A headless daemon may already own this session name from an earlier data
    # command. --session reuses the RUNNING browser, so --headed would be
    # ignored and the window would never appear. Close it first.
    ab(["close"], timeout=60)
    time.sleep(1)
    HEADED = True   # every call from here stays headed, or the window dies

    print("Opening Brightspace. Sign in with your school account in the window that appears.")
    print("(If it offers 'remember this device', tick it so you only do this once.)\n")

    p = ab(["open", HOME], headed=True, timeout=180)
    if p.returncode != 0:
        print("Could not open the browser: %s" % (p.stderr.strip() or p.stdout.strip()),
              file=sys.stderr)
        return 1

    deadline = time.time() + a.wait
    while time.time() < deadline:
        url = current_url()
        # Only probe once the browser is back on a Brightspace page - and never
        # navigate, or we would interrupt the login the user is completing.
        if url.startswith(HOST) and "/d2l/login" not in url:
            try:
                me = run_js_raw('return await api("/d2l/api/lp/" + LP + "/users/whoami");')
                if me and me.get("Identifier"):
                    print("Logged in as %s %s (%s)" % (
                        me.get("FirstName", ""), me.get("LastName", ""),
                        me.get("UniqueName", "")))
                    # Close cleanly so Chrome flushes cookies to the profile on
                    # disk; later headless runs restore the session from there.
                    ab(["close"], timeout=60)
                    print("Session saved to %s" % PROFILE)
                    return 0
            except (AuthError, BrowserError):
                pass
        time.sleep(3)

    print("Timed out after %ds waiting for login." % a.wait, file=sys.stderr)
    return 1


def cmd_status(a):
    try:
        me = run_js('return await api("/d2l/api/lp/" + LP + "/users/whoami");')
    except AuthError:
        print("Not logged in. Run: bs login")
        return 1
    print("Logged in as %s %s (%s)" % (
        me.get("FirstName", ""), me.get("LastName", ""), me.get("UniqueName", "")))
    return 0


def cmd_courses(a):
    data = run_js("return await %s;" % ("pinnedCourses()" if a.pinned else "activeCourses()"))
    def show(cs):
        if not cs:
            print("No active courses.")
            return
        for c in cs:
            pin = "*" if c.get("pinDate") else " "
            print("%s%-8s %s" % (pin, c["id"], c["name"]))
            if c.get("code"):
                print("         %s" % c["code"])
    out(data, a.json, show)
    return 0


def cmd_due(a):
    body = """
    const days = %d;
    const horizon = Date.now() + days * 86400000;
    const courses = %s;
    const results = await Promise.all(courses.map(function (c) {
      return settle(c.name, async function () {
        const items = [];
        try {
          const folders = await api("/d2l/api/le/" + LE + "/" + c.id + "/dropbox/folders/");
          (folders || []).forEach(function (f) {
            items.push({
              kind: "assignment", course: c.name, courseId: c.id,
              name: f.Name, due: f.DueDate,
              // NOT TotalUsersWithSubmissions: that counts how many students in
              // the class have submitted, not whether you have. It marked all
              // seven What Really Matters assignments done, including ones due
              // in December. A false "done" makes work get skipped, so only the
              // per-user CompletionStatus is trusted here.
              submitted: f.CompletionStatus === 1,
              url: "%s/d2l/lms/dropbox/user/folder_submit_files.d2l?db=" + f.Id + "&ou=" + c.id,
            });
          });
        } catch (e) { if (String(e.message) === "AUTH_EXPIRED") throw e; }
        try {
          const discs = await discussionTopics(c.id);
          (discs || []).forEach(function (t) {
            items.push({
              kind: "discussion", course: c.name, courseId: c.id,
              name: t.name + (t.points ? " (" + t.points + " pts)" : ""),
              due: t.due, submitted: false,
              url: "%s/d2l/le/" + c.id + "/discussions/topics/" + t.id + "/View",
            });
          });
        } catch (e) { if (String(e.message) === "AUTH_EXPIRED") throw e; }
        try {
          const quizzes = await paged("/d2l/api/le/" + LE + "/" + c.id + "/quizzes/");
          (quizzes || []).forEach(function (q) {
            items.push({
              kind: "quiz", course: c.name, courseId: c.id,
              name: q.Name, due: q.DueDate, submitted: false,
              url: "%s/d2l/lms/quizzing/user/quizzes_list.d2l?ou=" + c.id,
            });
          });
        } catch (e) { if (String(e.message) === "AUTH_EXPIRED") throw e; }
        return items;
      });
    }));
    const all = [], failed = [];
    results.forEach(function (r) {
      if (r.ok) all.push.apply(all, r.value);
      else failed.push({ course: r.label, error: r.error });
    });
    const upcoming = all.filter(function (i) {
      if (!i.due) return false;
      const t = Date.parse(i.due);
      return t <= horizon && t >= Date.now() - 7 * 86400000;
    });
    upcoming.sort(function (a, b) { return Date.parse(a.due) - Date.parse(b.due); });
    return { items: upcoming, failed: failed, days: days };
    """ % (a.days, "await activeCourses()", HOST, HOST, HOST)

    data = run_js(body)

    def show(d):
        items = d["items"]
        if not items:
            print("Nothing due in the next %d days." % d["days"])
        else:
            print("Due in the next %d days\n" % d["days"])
            for i in items:
                mark = "x" if i.get("submitted") else " "
                print("[%s] %-11s %s" % (mark, fmt_due(i["due"]), i["name"]))
                print("     %s - %s" % (i["course"], i["kind"]))
        for f in d.get("failed", []):
            print("\n! %s: %s" % (f["course"], f["error"]), file=sys.stderr)
    out(data, a.json, show)
    return 0


def cmd_grades(a):
    sel = "[{id:%s}]" % a.course if a.course else "await activeCourses()"
    body = """
    const courses = %s;
    const named = await activeCourses();
    const results = await Promise.all(courses.map(function (c) {
      const meta = named.filter(function (n) { return n.id == c.id; })[0] || c;
      return settle(meta.name || String(c.id), async function () {
        const vals = await api("/d2l/api/le/" + LE + "/" + c.id + "/grades/values/myGradeValues/");
        return {
          course: meta.name || String(c.id), courseId: c.id,
          grades: (vals || []).map(function (g) {
            return {
              name: g.GradeObjectName, displayed: g.DisplayedGrade,
              points: g.PointsNumerator, outOf: g.PointsDenominator,
              weighted: g.WeightedNumerator, weightedOutOf: g.WeightedDenominator,
            };
          }),
        };
      });
    }));
    return results;
    """ % sel

    data = run_js(body)

    def show(rs):
        for r in rs:
            if not r["ok"]:
                print("! %s: %s" % (r["label"], r["error"]), file=sys.stderr)
                continue
            v = r["value"]
            print("\n%s" % v["course"])
            if not v["grades"]:
                print("  (no grades posted)")
            for g in v["grades"]:
                score = g.get("displayed") or ""
                if g.get("points") is not None and g.get("outOf"):
                    score = "%s / %s" % (g["points"], g["outOf"])
                print("  %-45s %s" % (g["name"][:45], score))
    out(data, a.json, show)
    return 0


def cmd_announcements(a):
    sel = "[{id:%s}]" % a.course if a.course else "await activeCourses()"
    body = """
    const days = %d;
    const cutoff = Date.now() - days * 86400000;
    const courses = %s;
    const named = await activeCourses();
    const results = await Promise.all(courses.map(function (c) {
      const meta = named.filter(function (n) { return n.id == c.id; })[0] || c;
      return settle(meta.name || String(c.id), async function () {
        const news = await api("/d2l/api/le/" + LE + "/" + c.id + "/news/");
        return (news || [])
          .filter(function (n) { return !n.StartDate || Date.parse(n.StartDate) >= cutoff; })
          .map(function (n) {
            return {
              course: meta.name || String(c.id), courseId: c.id,
              title: n.Title, date: n.StartDate,
              body: (n.Body && (n.Body.Html || n.Body.Text)) || "",
            };
          });
      });
    }));
    const all = [];
    results.forEach(function (r) { if (r.ok) all.push.apply(all, r.value); });
    all.sort(function (a, b) { return Date.parse(b.date || 0) - Date.parse(a.date || 0); });
    return { items: all, failed: results.filter(function (r) { return !r.ok; }) };
    """ % (a.days, sel)

    data = run_js(body)

    def show(d):
        if not d["items"]:
            print("No announcements in the last %d days." % a.days)
        for n in d["items"]:
            when = parse_dt(n.get("date"))
            stamp = when.astimezone().strftime("%b %d") if when else "?"
            print("\n[%s] %s" % (stamp, n["title"]))
            print("  %s" % n["course"])
            text = strip_html(n.get("body"))
            if text:
                for ln in text.splitlines()[:8]:
                    print("  %s" % ln)
        for f in d.get("failed", []):
            print("\n! %s: %s" % (f["label"], f["error"]), file=sys.stderr)
    out(data, a.json, show)
    return 0


def cmd_content(a):
    body = """
    const toc = await api("/d2l/api/le/" + LE + "/%s/content/toc");
    return toc;
    """ % a.course

    data = run_js(body)

    def show(toc):
        def walk(modules, depth=0):
            for m in modules or []:
                print("%s%s" % ("  " * depth, m.get("Title", "?")))
                for t in m.get("Topics", []) or []:
                    print("%s- %s" % ("  " * (depth + 1), t.get("Title", "?")))
                walk(m.get("Modules"), depth + 1)
        walk(toc.get("Modules") if isinstance(toc, dict) else toc)
    out(data, a.json, show)
    return 0


def cmd_api(a):
    path = a.path if a.path.startswith("/") else "/" + a.path
    path = path.replace("{lp}", LP).replace("{le}", LE)
