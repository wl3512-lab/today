#!/usr/bin/env python3
"""bs - Brightspace (D2L) CLI for any school.

Drives the D2L Valence API from inside a logged-in agent-browser session,
so no API key or admin app registration is needed. Login state (including
any "remember this device" from the school's sign-in) lives in a persistent
Chrome profile.

The school's Brightspace address comes from BRIGHTSPACE_HOST, else from
lms.host in ~/.today/profile.json (TODAY_PROFILE overrides that path).
"""

import argparse
import base64
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone

def school_host():
    """https://<the school's Brightspace>, from the env or the Today profile."""
    host = os.environ.get("BRIGHTSPACE_HOST", "")
    if not host:
        path = os.path.expanduser(os.environ.get("TODAY_PROFILE", "~/.today/profile.json"))
        try:
            with open(path) as fh:
                host = ((json.load(fh).get("lms") or {}).get("host") or "")
        except (OSError, ValueError):
            host = ""
    host = host.strip().rstrip("/")
    if not host:
        sys.exit("bs: no Brightspace address. Set lms.host in ~/.today/profile.json "
                 "(e.g. brightspace.yourschool.edu) or BRIGHTSPACE_HOST.")
    return host if host.startswith("http") else "https://" + host


SESSION = os.environ.get("BRIGHTSPACE_SESSION", "brightspace")
PROFILE = os.path.expanduser("~/.brightspace-profile")
HOST = school_host()
HOME = HOST + "/d2l/home"
LP = "1.63"   # learning platform API version
LE = "1.97"   # learning environment API version


class AuthError(Exception):
    pass


class BrowserError(Exception):
    pass


# --------------------------------------------------------------------------
# agent-browser plumbing
# --------------------------------------------------------------------------

# agent-browser keys its daemon by session, but a call whose flags differ from
# the running browser TEARS IT DOWN and relaunches. A non-headed poll during
# login therefore kills the visible window mid-Duo. Once login starts, every
# call in the process must stay headed.
HEADED = False


# launchd hands a job PATH=/usr/bin:/bin:/usr/sbin:/sbin, which does not
# include ~/.local/bin where agent-browser is installed. A bare "agent-browser"
# therefore works in a terminal and raises FileNotFoundError under the
# scheduler - a traceback, not a BrowserError, so every caller saw a crash
# instead of a handled failure. Resolve to an absolute path once.
_AB_PATH = None


def agent_browser_bin():
    global _AB_PATH
    if _AB_PATH:
        return _AB_PATH
    found = shutil.which("agent-browser")
    if not found:
        for cand in ("~/.local/bin/agent-browser", "/opt/homebrew/bin/agent-browser",
                     "/usr/local/bin/agent-browser"):
            cand = os.path.expanduser(cand)
            if os.access(cand, os.X_OK):
                found = cand
                break
    if not found:
        raise BrowserError(
            "agent-browser not found. Install it, or add its directory to PATH.")
    _AB_PATH = found
    return found


def _cmd(args, headed=False):
    cmd = [agent_browser_bin(), "--session", SESSION, "--profile", PROFILE]
    if HEADED or headed:
        cmd.append("--headed")
    return cmd + args


def ab(args, headed=False, timeout=180):
    try:
        return subprocess.run(_cmd(args, headed), capture_output=True, text=True,
                              timeout=timeout)
    except FileNotFoundError as exc:
        raise BrowserError(str(exc))


def current_url():
    """Current page URL, or "" if it cannot be determined.

    `get url --json` nests the value under data.url, while `eval --json` uses
    data.result - accept either so a CLI change cannot silently blind us.
    """
    p = ab(["get", "url", "--json"], timeout=60)
    try:
        data = json.loads(p.stdout).get("data", {})
        if isinstance(data, str):
            return data
        return data.get("url") or data.get("result") or ""
    except Exception:
        return ""


def ensure_origin(headed=False):
    """Same-origin fetch requires us to be sitting on a brightspace page."""
    if current_url().startswith(HOST):
        return
    p = ab(["open", HOME], headed=headed, timeout=180)
    if p.returncode != 0:
        raise BrowserError(p.stderr.strip() or p.stdout.strip() or "failed to open Brightspace")
    # A cold-started browser reports about:blank for a moment, so one immediate
    # read is not evidence of anything. Poll until the URL settles.
    # Logged out, Brightspace bounces to the school's sign-in - a different origin,
    # where fetching the Valence API would just hit CORS.
    for _ in range(12):
        url = current_url()
        if url.startswith(HOST):
            return
        if "shibboleth" in url or "/d2l/login" in url:
            raise AuthError()
        time.sleep(0.5)
    raise AuthError()


JS_PRELUDE = r"""
const LP = "%s", LE = "%s";

async function api(path) {
  const r = await fetch(path, {
    credentials: "include",
    headers: { "Accept": "application/json" },
  });
  // 401 is "not authenticated"; 403 is "not allowed to see this", which is a
  // normal per-endpoint outcome (students cannot read classlist, say) and must
  // NOT be mistaken for a dead session or it aborts the whole run.
  // A genuinely dead session 302s to the SSO login page and returns HTML.
  if (r.status === 401) throw new Error("AUTH_EXPIRED");
  if (/\/d2l\/login|shibboleth|\/samlsso|\/idp\/|\/saml2?\//i.test(r.url)) throw new Error("AUTH_EXPIRED");
  const body = await r.text();
  if (!r.ok) throw new Error("HTTP_" + r.status + " " + path);
  if (!body) return null;
  try {
    return JSON.parse(body);
  } catch (e) {
    if (/<html|<!DOCTYPE/i.test(body)) throw new Error("AUTH_EXPIRED");
    throw new Error("NONJSON " + path + " :: " + body.slice(0, 120));
  }
}

// Valence paginates with an opaque bookmark cursor.
async function paged(base) {
  let out = [], bookmark = null;
  for (let guard = 0; guard < 60; guard++) {
    let u = base;
    if (bookmark !== null) u += (u.includes("?") ? "&" : "?") + "bookmark=" + encodeURIComponent(bookmark);
    const d = await api(u);
    if (!d) break;
    if (Array.isArray(d)) return out.concat(d);
    out = out.concat(d.Items || d.Objects || []);
    if (d.PagingInfo && d.PagingInfo.HasMoreItems) bookmark = d.PagingInfo.Bookmark;
    else break;
  }
  return out;
}

// Swallow a single missing endpoint without losing the rest of the course.
async function soft(fn, dflt) {
  try { return await fn(); }
  catch (e) {
    if (String(e.message) === "AUTH_EXPIRED") throw e;
    return dflt;
  }
}

// Discussions carry real, graded deadlines (reading responses, weekly papers)
// and live behind a two-step forum -> topics walk, which is why an
// assignments-and-quizzes-only view silently misses them.
async function discussionTopics(ouId) {
  const base = "/d2l/api/le/" + LE + "/" + ouId + "/discussions/forums/";
  const forums = await soft(function () { return api(base); }, []);
  const out = [];
  for (const f of forums || []) {
    const topics = await soft(function () {
      return api(base + f.ForumId + "/topics/");
    }, []);
    (topics || []).forEach(function (t) {
      if (t.IsHidden) return;
      out.push({
        forum: f.Name, forumId: f.ForumId, id: t.TopicId,
        name: t.Name, due: t.DueDate, points: t.ScoreOutOf,
      });
    });
  }
  return out;
}

// Never let one failing course kill the whole report.
async function settle(label, fn) {
  try { return { ok: true, label, value: await fn() }; }
  catch (e) {
    if (String(e.message) === "AUTH_EXPIRED") throw e;
    return { ok: false, label, error: String(e.message) };
  }
}

async function activeCourses() {
  const items = await paged("/d2l/api/lp/" + LP + "/enrollments/myenrollments/?orgUnitTypeId=3");
  const now = Date.now();
  return items
    .filter(function (e) {
      const a = e.Access || {};
      if (a.IsActive === false) return false;
      if (a.EndDate && Date.parse(a.EndDate) < now) return false;
      return true;
    })
    .map(function (e) {
      // MyOrgUnitInfo.PinDate is non-null exactly when the user pinned the course.
      return {
        id: e.OrgUnit.Id, name: e.OrgUnit.Name, code: e.OrgUnit.Code,
        pinDate: e.PinDate || null,
      };
    });
}

// Pinned only. If NOTHING is pinned we fall back to all active rather than
// returning an empty list - an empty planner is worse than an unfiltered one.
async function pinnedCourses() {
  const all = await activeCourses();
  const pinned = all.filter(function (c) { return !!c.pinDate; });
  return pinned.length ? pinned : all;
}

// Flatten the content tree into topics, keeping the module path for context.
async function tocTopics(ouId) {
  const toc = await api("/d2l/api/le/" + LE + "/" + ouId + "/content/toc");
  const out = [];
  (function walk(mods, trail) {
    (mods || []).forEach(function (m) {
      const path = trail.concat([m.Title || ""]);
      (m.Topics || []).forEach(function (t) {
        out.push({
          id: t.TopicId, title: t.Title || "", url: t.Url || "",
          type: t.TypeIdentifier || "", path: path.filter(Boolean).join(" / "),
        });
      });
      walk(m.Modules, path);
    });
  })((toc && toc.Modules) || [], []);
  return out;
}

// Content files are same-origin, so the session cookie fetches them directly.
// Binary (PDF/DOCX) cannot be read in-page - report the link instead of lying.
async function topicBody(url) {
  if (!url) return { kind: "none", note: "no url" };
  // Professors link three different ways: same-origin HTML, same-origin
  // binaries (.docx/.pdf), and off-site links (published Google Docs). Only
  // the first can be read in-page - the others are handed to the CLI, which
  // has the session cookie and real extraction tools.
  const absolute = /^https?:\/\//i.test(url);
  if (absolute && url.indexOf(location.host) < 0) {
    return { kind: "external", url: url, note: "external" };
  }
  try {
    const r = await fetch(url, { credentials: "include" });
    const ct = (r.headers.get("content-type") || "").toLowerCase();
    if (!r.ok) return { kind: "none", note: "HTTP " + r.status, contentType: ct };
    if (ct.indexOf("html") >= 0 || ct.indexOf("text/") >= 0) {
      return { kind: "html", text: await r.text(), note: "ok", contentType: ct };
    }
    const buf = await r.arrayBuffer();
    if (buf.byteLength > 6000000) {
      return { kind: "none", note: "too large (" + buf.byteLength + " bytes)", contentType: ct };
    }
    const bytes = new Uint8Array(buf);
    let bin = "";
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return { kind: "binary", b64: btoa(bin), note: "binary", contentType: ct };
  } catch (e) {
    return { kind: "none", note: String(e.message) };
  }
}
""" % (LP, LE)


def run_js(body, headed=False, timeout=300):
    ensure_origin(headed=headed)
    return run_js_raw(body, timeout=timeout)


def run_js_raw(body, timeout=300):
    """Evaluate without ensuring origin - never navigates the page.

    Login polling MUST use this: ensure_origin would re-open the Brightspace
    home URL every few seconds and yank the user off the Duo prompt mid-login.
    """
    script = "(async () => {\n%s\n%s\n})()" % (JS_PRELUDE, body)
    p = subprocess.run(
        _cmd(["eval", "--stdin", "--json"]),
        input=script, capture_output=True, text=True, timeout=timeout,
    )
    raw = p.stdout.strip()
    if not raw:
        raise BrowserError(p.stderr.strip() or "no output from agent-browser")
    try:
        env = json.loads(raw)
    except json.JSONDecodeError:
        raise BrowserError(raw[:400])
    if not env.get("success"):
        err = json.dumps(env.get("error"))
        if "AUTH_EXPIRED" in err:
            raise AuthError()
        raise BrowserError(err)
    return env.get("data", {}).get("result")


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------

def parse_dt(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def fmt_due(s):
    dt = parse_dt(s)
    if not dt:
        return "no due date"
    local = dt.astimezone()
    delta = local - datetime.now(timezone.utc).astimezone()
    days = delta.days
    if delta.total_seconds() < 0:
        rel = "OVERDUE"
    elif days == 0:
        rel = "today"
    elif days == 1:
        rel = "tomorrow"
    else:
        rel = "in %dd" % days
    return "%s (%s)" % (local.strftime("%a %b %d, %I:%M%p").replace(" 0", " "), rel)


def strip_html(s):
    if not s:
        return ""
    import re
    # Drop non-content blocks FIRST, or their contents survive tag-stripping and
    # you get Google's JavaScript in the middle of a syllabus.
    s = re.sub(r"(?is)<script\b.*?</script>", " ", s)
    s = re.sub(r"(?is)<style\b.*?</style>", " ", s)
    s = re.sub(r"(?is)<head\b.*?</head>", " ", s)
    s = re.sub(r"(?s)<!--.*?-->", " ", s)
    s = re.sub(r"<br\s*/?>", "\n", s, flags=re.I)
    s = re.sub(r"</p>", "\n", s, flags=re.I)
    s = re.sub(r"<[^>]+>", "", s)
    # html.unescape handles named AND numeric entities (&#160;, &#8217;, ...);
    # a hand-rolled replace list silently leaks the ones it forgot.
    import html as _html
    s = _html.unescape(s)
    return "\n".join(ln.rstrip() for ln in s.splitlines()).strip()


def out(obj, as_json, printer):
    if as_json:
        print(json.dumps(obj, indent=2))
    else:
        printer(obj)


